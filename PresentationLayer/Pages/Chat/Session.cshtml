@page
@model PresentationLayer.Pages.Chat.SessionModel
@{
    ViewData["Title"] = "Chat – " + (Model.Session?.Title ?? "");
    ViewData["TopbarTitle"] = "💬 " + (Model.Session?.Title ?? "Chat");
    Layout = "_Layout";
}

<style>
    .chat-shell { display:flex; height:calc(100vh - var(--topbar-h) - 1px); margin:-28px; }
    .chat-history { width:270px; flex-shrink:0; display:flex; flex-direction:column;
                    background:var(--bg-card); border-right:1px solid var(--border-subtle); }
    .chat-history-new { padding:14px; border-bottom:1px solid var(--border-subtle);
                        display:flex; flex-direction:column; gap:8px; }
    .chat-history-list { flex:1; overflow-y:auto; padding:8px; }
    .chat-history-item { display:block; padding:8px 10px; border-radius:8px; margin-bottom:4px;
                         color:var(--text-secondary); border:1px solid transparent; border-left:3px solid transparent; }
    .chat-history-item:hover { background:var(--bg-card-hover); color:var(--text-secondary); }
    .chat-history-item.active { background:var(--bg-card-hover); border-left-color:var(--accent-purple); }
    .chat-main { flex:1; display:flex; flex-direction:column; min-width:0; }
    .chat-subjectbar { padding:10px 16px; border-bottom:1px solid var(--border-subtle);
                       display:flex; align-items:center; gap:10px; flex-wrap:wrap; background:var(--bg-glass); }
    .chat-language { margin-left:auto; position:relative; }
    .chat-language-toggle { display:flex; align-items:center; gap:6px; border:1px solid var(--border-subtle);
                            border-radius:8px; padding:7px 10px; color:var(--text-secondary); background:var(--bg-card);
                            cursor:pointer; font-size:0.78rem; }
    .chat-language-toggle:hover, .chat-language.open .chat-language-toggle { border-color:var(--accent-purple); color:var(--text-primary); }
    .chat-language-panel { display:none; position:absolute; z-index:100; top:calc(100% + 8px); right:0;
                           width:min(720px, calc(100vw - 32px)); padding:16px; border:1px solid var(--border-subtle);
                           border-radius:12px; background:var(--bg-card); box-shadow:0 18px 42px rgba(0,0,0,.35); }
    .chat-language.open .chat-language-panel { display:block; }
    .language-panel-title { display:flex; align-items:center; gap:8px; margin-bottom:12px; color:var(--text-primary); font-weight:700; }
    .language-options { display:grid; grid-template-columns:repeat(3, minmax(0, 1fr)); gap:10px; }
    .language-option { min-height:92px; padding:14px; text-align:left; cursor:pointer; border:1px solid var(--border-subtle);
                       border-radius:9px; background:var(--bg-glass); color:var(--text-primary); transition:.15s ease; }
    .language-option:hover { border-color:var(--accent-purple); background:var(--bg-card-hover); }
    .language-option.selected { border-color:#6366f1; background:rgba(99,102,241,.12); box-shadow:0 0 0 1px #6366f1 inset; }
    .language-option strong { display:block; font-size:.9rem; margin-bottom:5px; }
    .language-option span { display:block; color:var(--text-muted); font-size:.76rem; line-height:1.35; }
    .language-note { display:flex; gap:7px; margin-top:12px; color:var(--text-muted); font-size:.75rem; line-height:1.4; }
    @@media (max-width: 620px) { .chat-language { margin-left:0; width:100%; } .chat-language-toggle { width:100%; justify-content:center; } .chat-language-panel { left:0; right:auto; width:100%; } .language-options { grid-template-columns:1fr; } .language-option { min-height:unset; } }
    @@media (max-width: 820px) { .chat-history { display:none; } .chat-shell { margin:-16px; } }

    /* Modal RAG Source Detail Styles */
    .modal-backdrop {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(4px);
        z-index: 9999;
        align-items: center;
        justify-content: center;
    }
    .modal-content {
        max-width: 650px;
        width: 90%;
        padding: 24px;
        background: var(--bg-card);
        border: 1px solid var(--border-subtle);
        border-radius: 12px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
        position: relative;
        max-height: 85vh;
        display: flex;
        flex-direction: column;
    }
    .modal-close-btn {
        background: transparent;
        border: none;
        color: var(--text-secondary);
        font-size: 1.5rem;
        cursor: pointer;
        position: absolute;
        top: 15px;
        right: 20px;
        line-height: 1;
    }
    .modal-close-btn:hover {
        color: var(--text-primary);
    }
    .modal-body {
        overflow-y: auto;
        font-size: 0.92rem;
        line-height: 1.6;
        white-space: pre-wrap;
        color: var(--text-primary);
        flex: 1;
        background: rgba(0,0,0,0.15);
        padding: 16px;
        border-radius: 8px;
        border-left: 4px solid var(--accent-blue);
        margin: 12px 0;
    }
    .source-title-link:hover {
        text-decoration: underline !important;
    }
    .citation-link {
        color: var(--accent-purple);
        font-weight: bold;
        text-decoration: none;
        margin: 0 2px;
        padding: 0 4px;
        background: rgba(168, 85, 247, 0.15);
        border-radius: 4px;
    }
    .citation-link:hover {
        background: rgba(168, 85, 247, 0.3);
        text-decoration: underline;
    }
</style>

@if (Model.Session == null)
{
    <div class="empty-state"><div class="empty-state-icon">❓</div><div>Không tìm thấy cuộc hội thoại.</div></div>
}
else
{
<div class="chat-shell">
    <!-- ── Thanh bên: chọn môn + lịch sử trò chuyện ── -->
    <aside class="chat-history">
        <form method="post" asp-page-handler="Create" class="chat-history-new">
            @Html.AntiForgeryToken()
            <label class="text-sm text-muted" style="font-weight:600">Hỏi về môn</label>
            <select name="subjectId" class="form-control">
                <option value="">🌐 Tất cả các môn</option>
                @foreach (var s in Model.Subjects)
                {
                    <option value="@s.Id">@s.Name</option>
                }
            </select>
            <button type="submit" class="btn btn-primary btn-sm">➕ Cuộc trò chuyện mới</button>
        </form>

        <div class="chat-history-list">
            <div class="text-sm text-muted" style="padding:6px 8px;font-weight:600">🕒 Lịch sử trò chuyện</div>
            @if (Model.Sessions.Count == 0)
            {
                <div class="text-sm text-muted" style="padding:8px">Chưa có cuộc trò chuyện nào.</div>
            }
            else
            {
                foreach (var s in Model.Sessions.OrderByDescending(x => x.UpdatedAt))
                {
                    var active = s.Id == Model.Session.Id;
                    <a href="/Chat/Session?id=@s.Id" class="chat-history-item @(active ? "active" : "")">
                        <div class="truncate" style="font-weight:600;font-size:0.85rem">@s.Title</div>
                        <div class="text-muted" style="font-size:0.7rem">
                            @Model.SubjectLabel(s.SubjectId) · @s.UpdatedAt.ToLocalTime().ToString("dd/MM HH:mm")
                        </div>
                    </a>
                }
            }
        </div>
    </aside>

    <!-- ── Khung chat chính ── -->
    <div class="chat-main">
        <div class="chat-subjectbar">
            <span class="badge badge-orange">@Model.SubjectLabel(Model.Session.SubjectId)</span>
            <span class="text-sm text-muted truncate">@Model.Session.Title</span>
            <div class="chat-language" id="answerLanguagePicker">
                <button type="button" class="chat-language-toggle" id="answerLanguageToggle" aria-expanded="false" aria-controls="answerLanguagePanel">
                    <span>🌐</span><span>Ngôn ngữ trả lời:</span><strong id="answerLanguageCurrent">Tiếng Việt</strong><span>⌄</span>
                </button>
                <div class="chat-language-panel" id="answerLanguagePanel" role="dialog" aria-label="Ngôn ngữ trả lời">
                    <div class="language-panel-title"><span>🌐</span> Ngôn ngữ trả lời</div>
                    <div class="language-options" role="radiogroup" aria-label="Chọn ngôn ngữ trả lời của AI">
                        <button type="button" class="language-option" data-answer-language="vi" role="radio">
                            <strong>Tiếng Việt</strong><span>AI luôn trả lời bằng tiếng Việt.</span>
                        </button>
                        <button type="button" class="language-option" data-answer-language="en" role="radio">
                            <strong>English</strong><span>AI will reply in English.</span>
                        </button>
                        <button type="button" class="language-option" data-answer-language="auto" role="radio">
                            <strong>Theo câu hỏi</strong><span>Tự động dùng ngôn ngữ của câu hỏi.</span>
                        </button>
                    </div>
                    <div class="language-note"><span>ⓘ</span><span>Câu từ chối khi không có tài liệu phù hợp luôn giữ nguyên tiếng Việt theo yêu cầu của dự án.</span></div>
                </div>
            </div>
        </div>

        <div class="chat-messages" id="chatMessages">
            @if (Model.Messages.Count == 0)
            {
                <div class="empty-state" id="emptyState">
                    <div class="empty-state-icon">🤖</div>
                    <div class="empty-state-title">AI sẵn sàng trợ giúp!</div>
                    <p class="empty-state-text">Đặt câu hỏi về tài liệu môn học bên dưới.</p>
                </div>
            }
            else
            {
                foreach (var msg in Model.Messages)
                {
                    <div class="bubble @msg.Role animate-fade-in" data-sources="@SessionModel.EncodeSources(msg.Sources)">
                        @if (msg.Role == "assistant")
                        {
                            <div style="font-size:0.75rem;color:var(--text-muted);margin-bottom:6px">🤖 AI</div>
                        }
                        <div class="message-content" style="white-space:pre-wrap">@msg.Content</div>

                        @if (msg.Role == "assistant" && msg.Sources.Count > 0)
                        {
                            <div style="margin-top:10px;border-top:1px solid var(--border-subtle);padding-top:8px">
                                <div style="font-size:0.72rem;color:var(--text-muted);margin-bottom:6px">📚 Trích dẫn từ tài liệu:</div>
                                @for (int idx = 0; idx < msg.Sources.Count; idx++)
                                {
                                    var src = msg.Sources[idx];
                                    <div style="margin-bottom:8px">
                                        <div style="font-size:0.75rem;">
                                            <a href="javascript:void(0)" class="source-title-link" onclick="openSourceModalDirect(this, @idx)" style="color:var(--accent-blue); font-weight:600; text-decoration:none;">
                                                📄 @src.DocumentName · Trang @src.Page · đoạn #@(src.ChunkIndex + 1)
                                            </a>
                                            @if(src.ConfidenceScore > 0)
                                            {
                                                <span style="color:var(--text-muted); font-size:0.7rem;">(Độ liên quan: @(Math.Round(src.ConfidenceScore * 100))%)</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(src.Snippet))
                                        {
                                            var preview = src.Snippet.Length > 150 ? src.Snippet.Substring(0, 150) + "..." : src.Snippet;
                                            <div style="font-size:0.72rem;color:var(--text-secondary);border-left:2px solid var(--accent-blue);padding-left:8px;margin-top:3px;font-style:italic">“@preview”</div>
                                        }
                                        <div style="font-size:0.68rem; margin-top:2px;">
                                            <a href="javascript:void(0)" onclick="openSourceModalDirect(this, @idx)" style="color:var(--accent-purple); text-decoration:underline;">[Xem đầy đủ]</a>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        <div style="font-size:0.68rem;color:var(--text-muted);margin-top:6px;text-align:right">
                            @msg.CreatedAt.ToLocalTime().ToString("HH:mm")
                        </div>
                    </div>
                }
            }
        </div>

        <!-- Input area -->
        <div class="chat-input-area">
            <a href="/Chat" class="btn btn-secondary btn-sm" title="Về danh sách chat">←</a>
            <div class="flex gap-2" style="flex:1">
                <textarea id="questionInput" class="form-control chat-input"
                          placeholder="Đặt câu hỏi về tài liệu... (Ctrl+Enter để gửi)"
                          rows="1" autofocus></textarea>
                <button type="button" class="btn btn-primary" id="sendBtn" title="Gửi (Ctrl+Enter)">
                    <span id="sendText">➤</span>
                    <span id="sendSpinner" style="display:none">⏳</span>
            </div>
        </div>
    </div>
</div>

<!-- Modal hiển thị chi tiết trích dẫn RAG -->
<div id="sourceModal" class="modal-backdrop">
    <div class="modal-content">
        <button type="button" class="modal-close-btn" onclick="closeSourceModal()">✕</button>
        <div style="border-bottom: 1px solid var(--border-subtle); padding-bottom: 10px; margin-bottom: 12px;">
            <h3 style="margin: 0; font-size: 1.15rem; display: flex; align-items: center; gap: 8px;">📚 Chi tiết đoạn trích tài liệu</h3>
        </div>
        <div style="font-size: 0.82rem; color: var(--text-muted); display: flex; flex-direction: column; gap: 4px; margin-bottom: 8px;">
            <div><strong>Tài liệu gốc:</strong> <span id="modalDocName" style="color: var(--accent-blue);"></span></div>
            <div><strong>Vị trí:</strong> Trang <span id="modalPage"></span> · Đoạn #<span id="modalChunkIndex"></span></div>
            <div><strong>Độ tương quan ngữ nghĩa:</strong> <span id="modalScore"></span>%</div>
        </div>
        <div class="modal-body" id="modalBody">Đang tải nội dung...</div>
        <div style="text-align: right; margin-top: 10px; display:flex; justify-content:flex-end; gap:8px;">
            <button type="button" class="btn btn-secondary" onclick="closeSourceModal()">Đóng</button>
        </div>
    </div>
</div>
}

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"
        crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script>
const SESSION_ID = '@Model.Session?.Id';
const msgs = document.getElementById('chatMessages');
const ta   = document.getElementById('questionInput');
const btn  = document.getElementById('sendBtn');
const ANSWER_LANGUAGE_STORAGE_KEY = 'prn222-answer-language';
const ANSWER_LANGUAGE_LABELS = { vi: 'Tiếng Việt', en: 'English', auto: 'Theo câu hỏi' };
const languagePicker = document.getElementById('answerLanguagePicker');
const languageToggle = document.getElementById('answerLanguageToggle');
const languageCurrent = document.getElementById('answerLanguageCurrent');
let answerLanguage = readAnswerLanguage();

function readAnswerLanguage() {
    try {
        const saved = localStorage.getItem(ANSWER_LANGUAGE_STORAGE_KEY);
        return ['vi', 'en', 'auto'].includes(saved) ? saved : 'vi';
    } catch (_) {
        return 'vi';
    }
}

function applyAnswerLanguage(value) {
    answerLanguage = ['vi', 'en', 'auto'].includes(value) ? value : 'vi';
    try { localStorage.setItem(ANSWER_LANGUAGE_STORAGE_KEY, answerLanguage); } catch (_) { }
    if (languageCurrent) languageCurrent.textContent = ANSWER_LANGUAGE_LABELS[answerLanguage];
    document.querySelectorAll('[data-answer-language]').forEach(option => {
        const selected = option.dataset.answerLanguage === answerLanguage;
        option.classList.toggle('selected', selected);
        option.setAttribute('aria-checked', String(selected));
    });
}

applyAnswerLanguage(answerLanguage);
languageToggle?.addEventListener('click', () => {
    const open = !languagePicker.classList.contains('open');
    languagePicker.classList.toggle('open', open);
    languageToggle.setAttribute('aria-expanded', String(open));
});
document.querySelectorAll('[data-answer-language]').forEach(option => {
    option.addEventListener('click', () => {
        applyAnswerLanguage(option.dataset.answerLanguage);
        languagePicker.classList.remove('open');
        languageToggle?.setAttribute('aria-expanded', 'false');
    });
});
document.addEventListener('click', event => {
    if (languagePicker && !languagePicker.contains(event.target)) {
        languagePicker.classList.remove('open');
        languageToggle?.setAttribute('aria-expanded', 'false');
    }
});
document.addEventListener('keydown', event => {
    if (event.key === 'Escape') {
        languagePicker?.classList.remove('open');
        languageToggle?.setAttribute('aria-expanded', 'false');
    }
});

// Auto-scroll
function scrollBottom() { if (msgs) msgs.scrollTop = msgs.scrollHeight; }
scrollBottom();

// Auto-resize textarea
if (ta) {
    ta.addEventListener('input', () => {
        ta.style.height = 'auto';
        ta.style.height = Math.min(ta.scrollHeight, 120) + 'px';
    });
}

// ---- Helpers ----
function nowStr() {
    return new Date().toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
}

function escHtml(s) {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}

function stripInlineCitations(s) {
    return (s || '').replace(/\s*\[(\d+)\]/g, '');
}

function appendBubble(role, html, sources) {
    document.getElementById('emptyState')?.remove();

    const div = document.createElement('div');
    div.className = `bubble ${role} animate-fade-in`;
    if (sources && sources.length > 0) {
        div.setAttribute('data-sources', encodeSourcesForBubble(sources));
    }

    let inner = '';
    if (role === 'assistant') inner += `<div style="font-size:0.75rem;color:var(--text-muted);margin-bottom:6px">🤖 AI</div>`;
    
    let formattedHtml = html;
    if (role === 'assistant') {
        formattedHtml = stripInlineCitations(html);
    }
    inner += `<div class="message-content" style="white-space:pre-wrap">${formattedHtml}</div>`;

    if (sources && sources.length > 0) {
        inner += `<div style="margin-top:10px;border-top:1px solid var(--border-subtle);padding-top:8px">
            <div style="font-size:0.72rem;color:var(--text-muted);margin-bottom:6px">📚 Trích dẫn từ tài liệu:</div>`;
        sources.forEach((s, idx) => {
            const pct = s.confidenceScore > 0
                ? ` <span style="color:var(--text-muted);font-size:0.7rem">(Độ liên quan: ${Math.round(s.confidenceScore * 100)}%)</span>`
                : '';
            const seg = (s.chunkIndex != null) ? ` · đoạn #${s.chunkIndex + 1}` : '';
            const preview = s.snippet 
                ? (s.snippet.length > 150 ? s.snippet.substring(0, 150) + "..." : s.snippet)
                : '';
            const quote = preview
                ? `<div style="font-size:0.72rem;color:var(--text-secondary);border-left:2px solid var(--accent-blue);padding-left:8px;margin-top:3px;font-style:italic">“${escHtml(preview)}”</div>`
                : '';
            inner += `<div style="margin-bottom:8px">
                <div style="font-size:0.75rem;">
                    <a href="javascript:void(0)" class="source-title-link" onclick="openSourceModalDirect(this, ${idx})" style="color:var(--accent-blue); font-weight:600; text-decoration:none;">
                        📄 ${escHtml(s.documentName)} · Trang ${s.page}${seg}
                    </a>
                    ${pct}
                </div>
                ${quote}
                <div style="font-size:0.68rem; margin-top:2px;">
                    <a href="javascript:void(0)" onclick="openSourceModalDirect(this, ${idx})" style="color:var(--accent-purple); text-decoration:underline;">[Xem đầy đủ]</a>
                </div>
            </div>`;
        });
        inner += `</div>`;
    }

    inner += `<div style="font-size:0.68rem;color:var(--text-muted);margin-top:6px;text-align:right">${nowStr()}</div>`;
    div.innerHTML = inner;
    msgs.appendChild(div);
    scrollBottom();
    return div;
}

function normalizeSource(s) {
    if (!s) return null;
    return {
        documentId: s.documentId || s.DocumentId || '',
        documentName: s.documentName || s.DocumentName || '',
        chunkIndex: s.chunkIndex ?? s.ChunkIndex ?? 0,
        page: s.page ?? s.Page ?? 0,
        snippet: s.snippet || s.Snippet || '',
        confidenceScore: s.confidenceScore ?? s.ConfidenceScore ?? 0
    };
}

function parseSourcesFromBubble(bubble) {
    const raw = bubble?.getAttribute('data-sources');
    if (!raw) return [];
    try {
        const json = raw.startsWith('b64:')
            ? atob(raw.slice(4))
            : raw;
        const parsed = JSON.parse(json);
        return Array.isArray(parsed) ? parsed.map(normalizeSource).filter(Boolean) : [];
    } catch (err) {
        console.error('Error parsing sources from bubble:', err);
        return [];
    }
}

function encodeSourcesForBubble(sources) {
    return 'b64:' + btoa(unescape(encodeURIComponent(JSON.stringify(sources || []))));
}

// Modal handling functions
async function showSourceInModal(s) {
    const src = normalizeSource(s);
    if (!src) return;

    document.getElementById('modalDocName').textContent = src.documentName || '—';
    document.getElementById('modalPage').textContent = src.page ?? '—';
    document.getElementById('modalChunkIndex').textContent = (src.chunkIndex ?? 0) + 1;
    document.getElementById('modalScore').textContent = src.confidenceScore > 0
        ? Math.round(src.confidenceScore * 100)
        : '0';

    const modalBody = document.getElementById('modalBody');
    modalBody.textContent = 'Đang tải nội dung...';
    document.getElementById('sourceModal').style.display = 'flex';

    let fullText = src.snippet || '';

    if (src.documentId) {
        try {
            const res = await fetch(`/api/documents/${encodeURIComponent(src.documentId)}/chunks/${src.chunkIndex}`);
            if (res.ok) {
                const data = await res.json();
                fullText = data.content || fullText;
            }
        } catch (err) {
            console.error('Failed to load full chunk content:', err);
        }
    }

    modalBody.textContent = fullText || '(Không có nội dung chi tiết)';
}

function openSourceModalDirect(el, index) {
    const bubble = el.closest('.bubble');
    const sources = parseSourcesFromBubble(bubble);
    if (sources[index]) showSourceInModal(sources[index]);
}

function closeSourceModal() {
    document.getElementById('sourceModal').style.display = 'none';
}

document.getElementById('sourceModal')?.addEventListener('click', e => {
    if (e.target.id === 'sourceModal') closeSourceModal();
});

// Format existing server messages on page load
function formatServerMessages() {
    document.querySelectorAll('.bubble.assistant').forEach(bubble => {
        const contentDiv = bubble.querySelector('.message-content');
        if (contentDiv) {
            contentDiv.innerHTML = stripInlineCitations(contentDiv.innerHTML);
        }
    });
}

// Run formatter on load
formatServerMessages();

function setLoading(on) {
    if (btn)  btn.disabled = on;
    if (ta)   ta.disabled  = on;
    document.getElementById('sendText').style.display    = on ? 'none' : '';
    document.getElementById('sendSpinner').style.display = on ? ''     : 'none';
}

// ---- SignalR ----
const connection = new signalR.HubConnectionBuilder()
    .withUrl('/hubs/chat')
    .withAutomaticReconnect()
    .build();

let thinkingBubble = null;

connection.on('Thinking', () => {
    thinkingBubble = appendBubble('assistant',
        '<em style="color:var(--text-muted)">⏳ AI đang suy nghĩ...</em>', null);
});

connection.on('ReceiveMessage', data => {
    thinkingBubble?.remove(); thinkingBubble = null;
    appendBubble('assistant', escHtml(data.answer).replace(/\n/g, '<br>'), data.sources);
    setLoading(false);
    ta?.focus();
});

connection.on('TokenBalanceChanged', data => {
    if (window.applyTokenBalance) window.applyTokenBalance(data);
});

connection.on('Error', msg => {
    thinkingBubble?.remove(); thinkingBubble = null;
    appendBubble('assistant', `⚠️ ${escHtml(msg)}`, null);
    setLoading(false);
});

(async () => {
    try { await connection.start(); }
    catch (e) { console.error('SignalR start error:', e); }
})();

// ---- Send ----
async function sendMessage() {
    const q = ta?.value.trim();
    if (!q) return;
    if (connection.state !== signalR.HubConnectionState.Connected) {
        alert('Đang kết nối lại... Vui lòng thử lại sau giây lát.');
        return;
    }

    appendBubble('user', escHtml(q).replace(/\n/g, '<br>'), null);
    ta.value = '';
    ta.style.height = 'auto';
    setLoading(true);

    try {
        await connection.invoke('SendMessageAsync', SESSION_ID, q, answerLanguage);
    } catch (e) {
        thinkingBubble?.remove(); thinkingBubble = null;
        appendBubble('assistant', '⚠️ Lỗi gửi tin nhắn. Vui lòng thử lại.', null);
        setLoading(false);
    }
}

btn?.addEventListener('click', sendMessage);
ta?.addEventListener('keydown', e => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') { e.preventDefault(); sendMessage(); }
});
</script>
}
