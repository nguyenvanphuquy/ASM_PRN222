@page
@using System.Security.Claims
@model PresentationLayer.Pages.Documents.ViewModel
@{
    ViewData["Title"] = "Chi tiết tài liệu";
    ViewData["TopbarTitle"] = "📄 Chi tiết tài liệu";
    var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "";
    // Admin chỉ giám sát — không được duyệt/từ chối tài liệu.
    var canManageDoc = role != "Admin" && (role == "Lecturer" || User.HasClaim("CanUpload", "true"));
    var canReChunk = canManageDoc && (Model.Document.Status == "Indexed"
        || Model.Document.Status == "Empty"
        || Model.Document.Status == "Failed"
        || Model.Document.Status == "Reviewing");
}

<div class="page-header flex items-center justify-between">
    <div>
        <div class="flex items-center gap-3">
            <a href="/Documents" class="btn btn-secondary btn-sm" style="border-radius: 50%; width: 32px; height: 32px; padding: 0; display: flex; align-items: center; justify-content: center; text-decoration: none;" title="Quay lại">
                🔙
            </a>
            <h1>@Model.Document.Title</h1>
        </div>
        <p class="mt-2 text-muted">
            @Model.Document.FileName • @(Model.Document.FileSize / 1024) KB • Ngày tải: @Model.Document.UploadedAt.ToString("dd/MM/yyyy")
            @if (!string.IsNullOrEmpty(Model.ChapterTitle))
            {
                <text> • Chương: @Model.ChapterTitle</text>
            }
            @if (!string.IsNullOrEmpty(Model.SubjectName))
            {
                <text> • Môn: @Model.SubjectName</text>
            }
        </p>
    </div>
    <div class="flex gap-2 items-center flex-wrap" style="justify-content:flex-end">
        <span class="badge @(Model.Document.Status == "Indexed" ? "badge-green" : Model.Document.Status == "Processing" || Model.Document.Status == "Indexing" ? "badge-orange" : Model.Document.Status == "Failed" ? "badge-red" : Model.Document.Status == "Reviewing" ? "badge-blue" : "badge-gray")" style="font-size: 1rem; padding: 0.5rem 1rem;">
            @Model.Document.Status
        </span>
        @if (Model.Document.Status == "Reviewing" && canManageDoc)
        {
            <form method="post" class="flex gap-2" style="display: inline-flex;">
                <button type="submit" asp-page-handler="Approve" asp-route-id="@Model.Document.Id" class="btn btn-primary">Duyệt &amp; Chunk</button>
                <button type="submit" asp-page-handler="Reject" asp-route-id="@Model.Document.Id" class="btn btn-danger">Từ chối</button>
            </form>
        }
        @if (canReChunk)
        {
            <form method="post" style="display:inline"
                  onsubmit="return confirm('Re-Chunk lại tài liệu theo cấu hình RBL hiện tại (chunking + embedding)?')">
                @Html.AntiForgeryToken()
                <button type="submit" asp-page-handler="ReChunk" asp-route-id="@Model.Document.Id" class="btn btn-secondary">
                    🔄 Re-Chunk
                </button>
            </form>
        }
    </div>
</div>

<div class="grid" style="grid-template-columns: 1fr; gap: 2rem;">
    @if (!string.IsNullOrEmpty(Model.Document.ExtractedText))
    {
        <div class="card" style="padding: 1.5rem; margin-bottom: 1rem;">
            <h3 style="margin: 0 0 1rem 0; color: var(--text-primary);">Nội dung trích xuất (Preview)</h3>
            <div style="max-height: 400px; overflow-y: auto; background: var(--surface-bg); padding: 1rem; border-radius: 4px; font-family: var(--font-mono, monospace); white-space: pre-wrap; font-size: 0.9rem; line-height: 1.6; border: 1px solid var(--border-color);">
                @Model.Document.ExtractedText
            </div>
        </div>
    }

    <div class="card" style="padding: 1.5rem;">
        <div class="flex items-center justify-between mb-4">
            <h3 style="margin: 0;">Các đoạn dữ liệu (Chunks)</h3>
            <span class="badge badge-blue">@Model.Chunks.Count chunks</span>
        </div>

        @if (Model.Chunks.Count == 0)
        {
            <div class="empty-state">
                <div class="empty-state-icon">🧩</div>
                <div class="empty-state-title">Chưa có chunk nào</div>
                <p class="empty-state-text">Tài liệu này chưa được chia chunk hoặc có lỗi trong quá trình xử lý.</p>
            </div>
        }
        else
        {
            <div class="chunk-list" id="chunkList">
                @foreach (var chunk in Model.Chunks.OrderBy(c => c.ChunkIndex))
                {
                    <div class="chunk-item">
                        <div class="flex justify-between items-center mb-3 flex-wrap gap-2">
                            <span class="badge" style="background: var(--accent-blue); color: white;">Chunk #@chunk.ChunkIndex</span>
                            <div class="flex gap-2 items-center">
                                @if (!string.IsNullOrEmpty(chunk.EmbeddingModel))
                                {
                                    <span class="badge badge-gray text-sm" title="Embedding model">@chunk.EmbeddingModel</span>
                                }
                                <span class="text-sm text-muted">Trang @chunk.Page</span>
                            </div>
                        </div>
                        @{
                            // PDF giữ xuống dòng theo bề rộng trang sách → cột hẹp, phải trống.
                            // Khi xem: gom dòng thành đoạn, để browser wrap full-width.
                            var raw = chunk.Content ?? "";
                            var display = System.Text.RegularExpressions.Regex.Replace(raw.Trim(), @"\r\n?", "\n");
                            display = System.Text.RegularExpressions.Regex.Replace(display, @"(?<!\n)\n(?!\n)", " ");
                            display = System.Text.RegularExpressions.Regex.Replace(display, @"[ \t]{2,}", " ");
                            display = System.Text.RegularExpressions.Regex.Replace(display, @"\n{3,}", "\n\n");
                        }
                        <div class="chunk-body">@display</div>
                        <div class="text-sm text-muted mt-2">@((chunk.Content ?? "").Length) ký tự</div>
                    </div>
                }
            </div>
            <nav id="chunkPager" class="chunk-pager" aria-label="Phân trang chunks"></nav>
        }
    </div>
</div>

@section Scripts {
<style>
    .chunk-pager {
        display: none; /* JS bật khi có nhiều hơn 1 trang */
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 1.25rem;
    }
    .chunk-pager button {
        min-width: 36px;
        height: 36px;
        padding: 0 10px;
        border: 1px solid var(--border-color, #d9d3c7);
        background: var(--surface-bg, #fff);
        color: var(--text-primary, #222);
        border-radius: 8px;
        font-size: 0.9rem;
        cursor: pointer;
        transition: background .15s, border-color .15s;
    }
    .chunk-pager button:hover:not(:disabled):not(.active) { background: var(--surface-hover, #f0ece3); }
    .chunk-pager button.active {
        background: var(--accent-blue, #2563eb);
        border-color: var(--accent-blue, #2563eb);
        color: #fff;
        font-weight: 600;
        cursor: default;
    }
    .chunk-pager button:disabled { opacity: .45; cursor: not-allowed; }
    .chunk-pager .chunk-pager-ellipsis { padding: 0 4px; color: var(--text-muted, #888); }
    .chunk-pager .chunk-pager-info {
        margin: 0 auto 0 0;
        font-size: 0.85rem;
        color: var(--text-muted, #888);
    }
</style>
<script>
(function () {
    var PAGE_SIZE = 10;
    var list = document.getElementById('chunkList');
    var pager = document.getElementById('chunkPager');
    if (!list || !pager) return;

    var items = Array.prototype.slice.call(list.querySelectorAll('.chunk-item'));
    var total = items.length;
    var pageCount = Math.ceil(total / PAGE_SIZE);
    if (pageCount <= 1) return; // 1 trang thì không cần phân trang

    var current = 1;

    function render() {
        // Ẩn/hiện chunk theo trang hiện tại
        var start = (current - 1) * PAGE_SIZE;
        var end = start + PAGE_SIZE;
        items.forEach(function (el, i) {
            el.style.display = (i >= start && i < end) ? '' : 'none';
        });
        buildControls();
    }

    // Tính dải số trang cần hiện (có "…" khi quá nhiều trang)
    function pageNumbers() {
        var nums = [];
        var add = function (n) { if (nums[nums.length - 1] !== n) nums.push(n); };
        add(1);
        for (var i = current - 1; i <= current + 1; i++) {
            if (i > 1 && i < pageCount) add(i);
        }
        if (pageCount > 1) add(pageCount);
        // Chèn ellipsis khi có khoảng cách
        var out = [];
        for (var j = 0; j < nums.length; j++) {
            if (j > 0 && nums[j] - nums[j - 1] > 1) out.push('...');
            out.push(nums[j]);
        }
        return out;
    }

    function makeBtn(label, opts) {
        opts = opts || {};
        var b = document.createElement('button');
        b.type = 'button';
        b.textContent = label;
        if (opts.disabled) b.disabled = true;
        if (opts.active) b.classList.add('active');
        if (opts.onClick && !opts.disabled && !opts.active) b.addEventListener('click', opts.onClick);
        return b;
    }

    function go(p) {
        current = Math.min(Math.max(1, p), pageCount);
        render();
        list.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    function buildControls() {
        pager.innerHTML = '';

        var info = document.createElement('span');
        info.className = 'chunk-pager-info';
        info.textContent = 'Trang ' + current + ' / ' + pageCount + ' · ' + total + ' chunks';
        pager.appendChild(info);

        pager.appendChild(makeBtn('«', { disabled: current === 1, onClick: function () { go(current - 1); } }));

        pageNumbers().forEach(function (n) {
            if (n === '...') {
                var e = document.createElement('span');
                e.className = 'chunk-pager-ellipsis';
                e.textContent = '…';
                pager.appendChild(e);
            } else {
                pager.appendChild(makeBtn(String(n), {
                    active: n === current,
                    onClick: function () { go(n); }
                }));
            }
        });

        pager.appendChild(makeBtn('»', { disabled: current === pageCount, onClick: function () { go(current + 1); } }));
    }

    pager.style.display = 'flex';
    render();
})();
</script>
}
