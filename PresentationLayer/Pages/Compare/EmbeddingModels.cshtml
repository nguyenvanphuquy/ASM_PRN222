@page
@model PresentationLayer.Pages.Compare.EmbeddingModelsModel
@{
    ViewData["Title"] = "So sánh Embedding";
    var res = Model.Result;
}

<div class="page-header">
    <h1>🧬 Benchmark Embedding Model</h1>
    <p>
        Cùng một câu hỏi · cùng bộ chunk · so sánh
        <strong>e5-base / text-embedding-3-small / PhoBERT / bge-m3</strong>
        theo cosine retrieval + câu trả lời RAG.
    </p>
</div>

<div class="card mb-4" style="border-left:4px solid #06b6d4;background:rgba(6,182,212,0.08)">
    <p style="margin:0;font-size:0.9rem;line-height:1.55">
        <strong>In-memory:</strong> Chunk cắt tạm bằng strategy hiện tại trong Settings (không ghi đè index).
        Cần <code>OpenAI API Key</code> và/hoặc <code>HuggingFace Token</code> trong Settings.
        Giới hạn ~6 tài liệu · ~40 chunk / model để tránh timeout.
    </p>
</div>

<div class="card mb-6">
    <form method="post" id="embForm">
        @Html.AntiForgeryToken()
        <div style="display:grid;grid-template-columns:2fr 1fr;gap:16px;align-items:end">
            <div class="form-group" style="margin-bottom:0">
                <label class="form-label">Câu hỏi *</label>
                <input asp-for="Question" class="form-control"
                       placeholder="VD: Dependency Injection trong ASP.NET Core là gì?" required />
                <span asp-validation-for="Question" class="form-error"></span>
            </div>
            <div class="form-group" style="margin-bottom:0">
                <label class="form-label">Môn học *</label>
                <select asp-for="SubjectId" class="form-control" required>
                    <option value="">– Chọn môn học –</option>
                    @foreach (var s in Model.Subjects)
                    {
                        <option value="@s.Id">@s.Code – @s.Name</option>
                    }
                </select>
                <span asp-validation-for="SubjectId" class="form-error"></span>
            </div>
        </div>
        <div class="mt-4 flex gap-2 flex-wrap">
            <button type="submit" id="embBtn" class="btn btn-primary">
                <span id="embText">⚡ Chạy so sánh 4 embedding model</span>
                <span id="embSpin" class="hidden animate-spin">⏳</span>
            </button>
            <a href="/Compare/ChunkingStrategies" class="btn btn-secondary">✂️ So sánh Chunking</a>
            <a href="/Compare/EmbeddingModels" class="btn btn-secondary">🧬 So sánh Embedding</a>
            <a href="/Compare/Models" class="btn btn-secondary">🧪 So sánh Model</a>
            <a href="/Compare/RagVsFineTuned" class="btn btn-secondary">🔬 RAG vs Fine-tuned</a>
        </div>
    </form>
</div>

@if (res != null)
{
    <div class="flex items-center justify-between mb-4" style="flex-wrap:wrap;gap:8px">
        <h3>Kết quả cho: <span style="color:var(--accent-purple)">"@res.Question"</span></h3>
        <div class="flex gap-2 flex-wrap">
            <span class="badge badge-blue">📚 @res.DocumentsUsed tài liệu</span>
            <span class="badge badge-purple">✂️ @res.ChunkingStrategy</span>
            <span class="badge badge-green">🧩 @res.ChunksBuilt chunk</span>
            @if (!string.IsNullOrEmpty(res.SubjectName))
            {
                <span class="badge badge-blue">@res.SubjectName</span>
            }
        </div>
    </div>

    @if (res.Insights.Notes.Count > 0)
    {
        <div class="card mb-6">
            <div class="card-header" style="padding:0 0 12px;border-bottom:1px solid var(--border-subtle);margin-bottom:12px">
                <span class="card-title">📌 Insights</span>
            </div>
            <div class="flex gap-2 flex-wrap mb-3">
                @if (!string.IsNullOrEmpty(res.Insights.WinnerRetrieval))
                {
                    <span class="badge badge-green">Retrieval: @res.Insights.WinnerRetrieval</span>
                }
                @if (!string.IsNullOrEmpty(res.Insights.WinnerEmbedLatency))
                {
                    <span class="badge badge-purple">Embed nhanh: @res.Insights.WinnerEmbedLatency</span>
                }
                @if (!string.IsNullOrEmpty(res.Insights.WinnerE2ELatency))
                {
                    <span class="badge badge-blue">E2E nhanh: @res.Insights.WinnerE2ELatency</span>
                }
            </div>
            <ul style="margin:0;padding-left:18px;line-height:1.6;font-size:0.9rem;color:var(--text-secondary)">
                @foreach (var n in res.Insights.Notes)
                {
                    <li>@n</li>
                }
            </ul>
        </div>
    }

    <div class="card mb-6" style="padding:0">
        <div class="card-header" style="padding:20px 24px 16px"><span class="card-title">📊 Chỉ số so sánh</span></div>
        <div class="table-wrapper" style="border:none">
            <table>
                <thead>
                    <tr>
                        <th>Model</th>
                        <th>Provider</th>
                        <th class="text-right"># Embed</th>
                        <th class="text-right">Top score</th>
                        <th class="text-right">Avg top-5</th>
                        <th class="text-right">Embed ms</th>
                        <th class="text-right">E2E ms</th>
                        <th class="text-right">Token</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var ok = res.Models.Where(m => !m.IsError).ToList();
                        var bestScore = ok.Count > 0 ? ok.Max(m => m.AvgTopScore) : 0;
                        var bestEmbed = ok.Count > 0 ? ok.Min(m => m.EmbedLatencyMs) : 0;
                    }
                    @foreach (var m in res.Models)
                    {
                        <tr>
                            <td style="font-weight:600">
                                @m.DisplayName
                                @if (m.IsError) { <span class="badge badge-red" style="margin-left:4px">Lỗi</span> }
                            </td>
                            <td class="text-sm text-muted">@m.Provider</td>
                            <td class="text-right">@m.EmbeddedChunks.ToString("N0")</td>
                            <td class="text-right">@m.TopScore.ToString("F3")</td>
                            <td class="text-right" style="font-weight:600">
                                @m.AvgTopScore.ToString("F3")
                                @if (!m.IsError && ok.Count > 1 && Math.Abs(m.AvgTopScore - bestScore) < 0.0001f)
                                {
                                    <span class="badge badge-green" style="margin-left:4px">cao nhất</span>
                                }
                            </td>
                            <td class="text-right">
                                @m.EmbedLatencyMs
                                @if (!m.IsError && ok.Count > 1 && m.EmbedLatencyMs == bestEmbed)
                                {
                                    <span class="badge badge-purple" style="margin-left:4px">nhanh</span>
                                }
                            </td>
                            <td class="text-right">@m.LatencyMs</td>
                            <td class="text-right">@m.TotalTokens.ToString("N0")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:16px">
        @foreach (var m in res.Models)
        {
            <div class="card" style="display:flex;flex-direction:column">
                <div class="flex items-center justify-between mb-3" style="padding-bottom:12px;border-bottom:1px solid var(--border-subtle)">
                    <div>
                        <div style="font-weight:700">@m.DisplayName</div>
                        <div class="text-sm text-muted">@m.Provider · @m.Description</div>
                    </div>
                    @if (m.IsError)
                    {
                        <span class="badge badge-red">Lỗi</span>
                    }
                    else
                    {
                        <span class="badge badge-blue">@m.AvgTopScore.ToString("F2") · @m.LatencyMs ms</span>
                    }
                </div>

                @if (m.Hits.Count > 0)
                {
                    <div class="mb-3" style="font-size:0.8rem">
                        <div class="text-muted mb-1" style="font-weight:600">Top retrieval (cosine)</div>
                        @foreach (var h in m.Hits.Take(3))
                        {
                            <div style="padding:6px 0;border-bottom:1px dashed var(--border-subtle)">
                                <span class="badge badge-green" style="margin-right:4px">@h.Score.ToString("F2")</span>
                                <span style="font-weight:600">@h.DocumentName</span>
                                <span class="text-muted"> · p.@h.Page</span>
                                <div class="text-muted" style="margin-top:2px">@h.Snippet</div>
                            </div>
                        }
                    </div>
                }

                <div style="white-space:pre-wrap;font-size:0.9rem;line-height:1.6;color:var(--text-primary);flex:1">@m.Answer</div>
            </div>
        }
    </div>
}

@section Scripts {
<script>
    document.getElementById('embForm').addEventListener('submit', function () {
        document.getElementById('embText').classList.add('hidden');
        document.getElementById('embSpin').classList.remove('hidden');
        document.getElementById('embBtn').disabled = true;
    });
</script>
}
