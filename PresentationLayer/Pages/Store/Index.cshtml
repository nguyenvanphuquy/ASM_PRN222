@page
@model PresentationLayer.Pages.Store.IndexModel
@{
    ViewData["Title"] = "Cửa hàng gói";
    var b = Model.Balance;
    var unlimited = Model.Role is "Admin" or "Lecturer";
    var usedPct = b.Granted > 0 ? (int)(b.Used * 100L / b.Granted) : 0;
}

<div class="page-header">
    <h1>Cửa hàng gói token</h1>
    <p>Mua gói để có thêm token cho hỏi đáp AI. Thanh toán giả lập — token được cộng ngay lập tức.</p>
</div>

<!-- Số dư token -->
<div class="card mb-6" style="background:var(--grad-surface)">
    <div class="flex items-center justify-between" style="flex-wrap:wrap;gap:16px">
        <div>
            <div class="text-sm text-muted" style="text-transform:uppercase;letter-spacing:0.05em;font-weight:600">Số dư token khả dụng</div>
            @if (unlimited)
            {
                <div style="font-size:2.2rem;font-weight:800;color:var(--accent-purple)">Không giới hạn</div>
                <div class="text-sm text-muted">Tài khoản @Model.Role không bị tính phí token.</div>
            }
            else
            {
            <div style="font-size:2.2rem;font-weight:800;color:var(--accent-purple)" id="storeRemaining">@b.Remaining.ToString("N0")</div>
                <div class="text-sm text-muted" id="storeUsageLine">Đã dùng @b.Used.ToString("N0") / @b.Granted.ToString("N0") token@(b.NextExpiry != null ? $" · hết hạn {b.NextExpiry.Value.ToLocalTime():dd/MM/yyyy}" : "")</div>
            }
        </div>
        @if (!unlimited)
        {
            <div style="flex:1;min-width:220px;max-width:420px">
                <div style="height:12px;background:rgba(43,37,33,0.08);border-radius:var(--radius-full);overflow:hidden">
                    <div style="height:100%;width:@(usedPct)%;background:var(--grad-primary)"></div>
                </div>
                <div class="text-sm text-muted text-right" style="margin-top:6px">@usedPct% đã sử dụng</div>
            </div>
        }
    </div>
</div>

<!-- Danh sách gói -->
<h3 class="mb-4">📦 Chọn gói</h3>
<div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px;margin-bottom:28px">
    @foreach (var p in Model.Packages)
    {
        <div class="card" style="position:relative;display:flex;flex-direction:column;@(p.IsPopular ? "border-color:var(--accent-purple);box-shadow:var(--shadow-glow)" : "")">
            @if (p.IsPopular)
            {
                <span class="badge badge-purple" style="position:absolute;top:16px;right:16px">🔥 Phổ biến</span>
            }
            <div style="font-size:1.15rem;font-weight:700;margin-bottom:4px">@p.Name</div>
            <div class="text-sm text-muted" style="min-height:2.6em;margin-bottom:12px">@p.Description</div>
            <div style="font-size:1.8rem;font-weight:800;color:var(--accent-purple);line-height:1">
                @(p.PriceVnd == 0 ? "Miễn phí" : $"{p.PriceVnd:N0}₫")
            </div>
            <div style="display:flex;flex-direction:column;gap:6px;margin:14px 0;font-size:0.85rem;color:var(--text-secondary)">
                <div>🔢 <strong>@p.TokenQuota.ToString("N0")</strong> token</div>
                <div>⏳ Hiệu lực @(p.DurationDays > 0 ? $"{p.DurationDays} ngày" : "vĩnh viễn")</div>
            </div>
            @if (unlimited)
            {
                <div class="text-sm text-muted" style="margin-top:auto;text-align:center;padding:10px 0;border-top:1px dashed var(--border-subtle)">
                    Bạn dùng token <strong>không giới hạn</strong> — không cần mua gói.
                </div>
            }
            else
            {
                <form method="post" asp-page-handler="Buy" style="margin-top:auto"
                      data-name="@p.Name" data-price="@(p.PriceVnd == 0 ? "miễn phí" : $"{p.PriceVnd:N0}₫")"
                      onsubmit="return storeBuy(this)">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="packageId" value="@p.Id" />
                    @* Khoá chống mua trùng: mỗi lần render 1 key; double-click ⇒ vẫn 1 giao dịch. *@
                    <input type="hidden" name="idempotencyKey" value="@Guid.NewGuid()" />
                    <button type="submit" class="btn @(p.IsPopular ? "btn-primary" : "btn-secondary") w-full">
                        🛒 Mua gói
                    </button>
                </form>
            }
        </div>
    }
</div>

<!-- Lịch sử giao dịch -->
<div class="card" style="padding:0">
    <div class="card-header" style="padding:20px 24px 16px"><span class="card-title">🧾 Lịch sử mua gói</span></div>
    <div class="table-wrapper" style="border:none">
        <table>
            <thead>
                <tr><th>Mã GD</th><th>Gói</th><th class="text-right">Số tiền</th><th class="text-right">Token</th><th>Trạng thái</th><th class="text-right">Ngày</th></tr>
            </thead>
            <tbody data-pager="10" data-pager-label="giao dịch">
                @if (Model.History.Count == 0)
                {
                    <tr><td colspan="6" style="text-align:center;padding:28px;color:var(--text-muted)">Chưa có giao dịch nào.</td></tr>
                }
                else
                {
                    foreach (var h in Model.History)
                    {
                        <tr>
                            <td class="text-sm text-muted">@h.TransactionRef</td>
                            <td style="font-weight:600;color:var(--text-primary)">@h.PackageName</td>
                            <td class="text-right">@(h.AmountVnd == 0 ? "Miễn phí" : $"{h.AmountVnd:N0}₫")</td>
                            <td class="text-right text-muted">@h.TokensUsed.ToString("N0") / @h.TokensGranted.ToString("N0")</td>
                            <td>
                                @{
                                    var stillValid = h.ExpiresAt.HasValue && h.ExpiresAt.Value > DateTime.UtcNow;
                                }
                                @if (h.Status == "Paid")
                                {
                                    <span class="badge badge-green">Đang dùng</span>
                                }
                                else if (h.Status == "Cancelled" && stillValid)
                                {
                                    <span class="badge" style="background:#f59e0b;color:#fff" title="Đã hủy nhưng vẫn dùng được token tới hết hạn">
                                        Đã hủy · còn đến @h.ExpiresAt!.Value.ToLocalTime().ToString("dd/MM/yyyy")
                                    </span>
                                }
                                else if (h.Status == "Cancelled")
                                {
                                    <span class="badge badge-gray">Đã hủy (đã hết hạn)</span>
                                }
                                else
                                {
                                    <span class="badge badge-gray">@h.Status</span>
                                }
                                @if (h.Status == "Paid" && h.PaymentMethod != "Free")
                                {
                                    <form method="post" asp-page-handler="Cancel" style="display:inline-block;margin-left:6px" onsubmit="return confirm('Huỷ gói này? Bạn VẪN được dùng số token còn lại tới hết hạn — chỉ ngừng gia hạn thôi.')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="purchaseId" value="@h.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger" style="padding:2px 8px;font-size:0.75rem;line-height:1.2;height:auto;min-height:0">Huỷ gia hạn</button>
                                    </form>
                                }
                            </td>
                            <td class="text-right text-sm text-muted">@h.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    // Xác nhận mua + chống double-click (khoá nút ngay sau khi submit). Idempotency key ở
    // form đảm bảo dù có lọt 2 request thì backend cũng chỉ tạo 1 giao dịch.
    function storeBuy(form) {
        if (!confirm('Xác nhận mua ' + form.dataset.name + ' với giá ' + form.dataset.price + '? (thanh toán giả lập)'))
            return false;
        var btn = form.querySelector('button[type=submit]');
        if (btn) setTimeout(function () { btn.disabled = true; btn.textContent = '⏳ Đang xử lý…'; }, 0);
        return true;
    }

    // Realtime: khi admin tạo/sửa/xoá gói, sinh viên tự thấy danh sách gói mới cập nhật.
    (function subscribe() {
        if (window.appNotifHub) {
            window.appNotifHub.on('PackagesChanged', function () {
                var bar = document.getElementById('pkgUpdateBar');
                if (!bar) {
                    bar = document.createElement('div');
                    bar.id = 'pkgUpdateBar';
                    bar.style.cssText = 'position:fixed;left:50%;top:16px;transform:translateX(-50%);z-index:9999;' +
                        'background:var(--accent-green,#3fa46a);color:#fff;padding:10px 18px;border-radius:999px;' +
                        'box-shadow:0 6px 20px rgba(0,0,0,.18);font-size:.9rem';
                    bar.textContent = '🔄 Danh sách gói vừa được cập nhật — đang làm mới…';
                    document.body.appendChild(bar);
                }
                setTimeout(function () { window.location.reload(); }, 900);
            });
            window.appNotifHub.on('TokenBalanceChanged', function (d) {
                if (!d) return;
                var rem = document.getElementById('storeRemaining');
                var line = document.getElementById('storeUsageLine');
                if (rem && typeof d.remaining === 'number')
                    rem.textContent = d.remaining.toLocaleString('vi-VN');
                if (line && typeof d.used === 'number' && typeof d.granted === 'number')
                    line.textContent = 'Đã dùng ' + d.used.toLocaleString('vi-VN') + ' / ' + d.granted.toLocaleString('vi-VN') + ' token';
                if (window.applyTokenBalance) window.applyTokenBalance(d);
            });
        } else {
            setTimeout(subscribe, 300);
        }
    })();
</script>
}
