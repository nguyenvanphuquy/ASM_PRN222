@page
@model PresentationLayer.Pages.Dashboard.ExperimentsModel
@{
    ViewData["Title"] = "Dashboard RBL";
    var d = Model.Data;
}

<div class="page-header">
    <h1>📊 Dashboard kết quả thực nghiệm RBL</h1>
    <p>Tổng hợp các lần chạy Chunking · Embedding · RAG vs Fine-tuned (tự lưu khi bạn chạy so sánh).</p>
</div>

<div class="stats-grid">
    <div class="stat-card purple">
        <div class="stat-icon purple">🧪</div>
        <div class="stat-value">@d.TotalRuns</div>
        <div class="stat-label">Tổng lần chạy</div>
    </div>
    <div class="stat-card blue">
        <div class="stat-icon blue">✂️</div>
        <div class="stat-value">@d.ChunkingRuns</div>
        <div class="stat-label">Chunking</div>
    </div>
    <div class="stat-card green">
        <div class="stat-icon green">🧬</div>
        <div class="stat-value">@d.EmbeddingRuns</div>
        <div class="stat-label">Embedding</div>
    </div>
    <div class="stat-card orange">
        <div class="stat-icon orange">🔬</div>
        <div class="stat-value">@d.RagVsFtRuns</div>
        <div class="stat-label">RAG vs FT</div>
    </div>
</div>

<div class="flex gap-2 flex-wrap mb-6">
    <a href="/Compare/ChunkingStrategies" class="btn btn-secondary btn-sm">✂️ Chunking</a>
    <a href="/Compare/EmbeddingModels" class="btn btn-secondary btn-sm">🧬 Embedding</a>
    <a href="/Compare/RagVsFineTuned" class="btn btn-secondary btn-sm">🔬 RAG vs Fine-tuned</a>
    <a href="/Compare/Models" class="btn btn-secondary btn-sm">🧪 So sánh Model</a>
</div>

@if (d.TotalRuns == 0)
{
    <div class="card">
        <div class="empty-state" style="padding:48px">
            <div class="empty-state-icon">📭</div>
            <div class="empty-state-title">Chưa có kết quả thực nghiệm</div>
            <p class="text-muted" style="margin-top:8px">Chạy một benchmark ở menu So sánh — kết quả sẽ xuất hiện ở đây.</p>
        </div>
    </div>
}
else
{
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px;margin-bottom:24px">
        <div class="card">
            <div class="card-header"><span class="card-title">✂️ Chunking — avg score</span></div>
            <canvas id="chunkChart" height="200"></canvas>
            @if (d.ChunkingAgg.Count == 0)
            {
                <p class="text-muted text-sm">Chưa có dữ liệu chunking.</p>
            }
        </div>
        <div class="card">
            <div class="card-header"><span class="card-title">🧬 Embedding — avg cosine</span></div>
            <canvas id="embedChart" height="200"></canvas>
            @if (d.EmbeddingAgg.Count == 0)
            {
                <p class="text-muted text-sm">Chưa có dữ liệu embedding.</p>
            }
        </div>
        <div class="card">
            <div class="card-header"><span class="card-title">🔬 RAG vs FT — avg latency (ms)</span></div>
            <canvas id="rftChart" height="200"></canvas>
            @if (d.RagVsFtAgg.Count == 0)
            {
                <p class="text-muted text-sm">Chưa có dữ liệu RAG vs FT.</p>
            }
        </div>
    </div>

    <div class="card" style="padding:0">
        <div class="card-header" style="padding:20px 24px 16px">
            <span class="card-title">📋 Lịch sử lần chạy gần đây</span>
        </div>
        <div class="table-wrapper" style="border:none">
            <table>
                <thead>
                    <tr>
                        <th>Thời gian</th>
                        <th>Loại</th>
                        <th>Câu hỏi</th>
                        <th>Môn</th>
                        <th>Winner</th>
                        <th>Variants</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in d.RecentRuns)
                    {
                        <tr>
                            <td class="text-sm text-muted">@r.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</td>
                            <td>
                                @{
                                    var badge = r.Kind switch
                                    {
                                        "chunking" => "badge-blue",
                                        "embedding" => "badge-green",
                                        _ => "badge-purple"
                                    };
                                }
                                <span class="badge @badge">@r.KindLabel</span>
                            </td>
                            <td style="max-width:280px">
                                <div class="truncate" style="font-weight:600" title="@r.Question">@r.Question</div>
                            </td>
                            <td class="text-sm text-muted">@(r.SubjectName ?? "–")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(r.WinnerLabel))
                                {
                                    <span class="badge badge-green">@r.WinnerLabel</span>
                                }
                                else { <span class="text-muted">–</span> }
                            </td>
                            <td class="text-sm">
                                @foreach (var v in r.Variants.Take(4))
                                {
                                    <div style="margin-bottom:2px">
                                        @if (v.IsError)
                                        {
                                            <span class="text-muted">@v.VariantLabel · lỗi</span>
                                        }
                                        else
                                        {
                                            <strong>@v.VariantLabel</strong>
                                            <span class="text-muted"> · score @v.Score.ToString("F2") · @v.LatencyMs ms</span>
                                        }
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
    const chunkLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(d.ChunkingAgg.Select(x => x.VariantLabel)));
    const chunkScores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(d.ChunkingAgg.Select(x => Math.Round(x.AvgScore, 3))));
    const embedLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(d.EmbeddingAgg.Select(x => x.VariantLabel)));
    const embedScores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(d.EmbeddingAgg.Select(x => Math.Round(x.AvgScore, 3))));
    const rftLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(d.RagVsFtAgg.Select(x => x.VariantLabel)));
    const rftLatency = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(d.RagVsFtAgg.Select(x => Math.Round(x.AvgLatencyMs, 0))));

    function barChart(id, labels, data, color) {
        const el = document.getElementById(id);
        if (!el || !window.Chart || !labels.length) return;
        new Chart(el, {
            type: 'bar',
            data: {
                labels,
                datasets: [{
                    label: 'Giá trị',
                    data,
                    backgroundColor: color,
                    borderRadius: 6,
                    maxBarThickness: 48
                }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: {
                    x: { ticks: { color: '#a99d8e', maxRotation: 30 }, grid: { display: false } },
                    y: { beginAtZero: true, ticks: { color: '#a99d8e' }, grid: { color: 'rgba(43,37,33,0.06)' } }
                }
            }
        });
    }

    barChart('chunkChart', chunkLabels, chunkScores, 'rgba(99,102,241,0.75)');
    barChart('embedChart', embedLabels, embedScores, 'rgba(6,182,212,0.75)');
    barChart('rftChart', rftLabels, rftLatency, 'rgba(245,158,11,0.75)');
</script>
}
