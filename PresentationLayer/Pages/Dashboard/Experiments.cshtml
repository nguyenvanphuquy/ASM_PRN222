@page
@model PresentationLayer.Pages.Dashboard.ExperimentsModel
@{
    ViewData["Title"] = "Dashboard RBL";
    var d = Model.Data;
    var rag = d.Ragas;
    var filter = d.FilterKind;
}

<div class="page-header">
    <h1>📊 Dashboard kết quả thực nghiệm RBL</h1>
    <p>Tổng hợp Chunking · Embedding · RAG vs Fine-tuned · RAGAS. Kết quả tự lưu khi chạy benchmark.</p>
</div>

<div class="flex gap-2 flex-wrap items-center mb-4">
    @if (d.SidecarOnline)
    {
        <span class="badge badge-green">🟢 Sidecar embedding online</span>
    }
    else
    {
        <span class="badge badge-red">🔴 Sidecar offline — e5/PhoBERT/bge sẽ bỏ qua</span>
    }
    <span class="text-sm text-muted">App tự khởi động sidecar; hoặc chạy: python tools/embedding_server.py</span>
</div>

@if (Model.SuiteResult != null)
{
    var sr = Model.SuiteResult;
    <div class="card mb-4" style="border-left:4px solid @(sr.Success ? "#22c55e" : "#f59e0b")">
        @if (sr.Success)
        {
            <p style="margin:0"><strong>✅ Bộ thực nghiệm chuẩn hoàn tất</strong> — @sr.Completed.Count bước · @sr.TotalMs ms · môn @sr.SubjectCode</p>
        }
        else
        {
            <p style="margin:0 0 8px"><strong>⚠ Bộ thực nghiệm kết thúc một phần</strong> — @sr.Completed.Count thành công · @sr.Errors.Count lỗi · @sr.TotalMs ms</p>
            @if (sr.Errors.Count > 0)
            {
                <ul style="margin:0;padding-left:18px;font-size:0.9rem;color:var(--text-secondary)">
                    @foreach (var e in sr.Errors) { <li>@e</li> }
                </ul>
            }
        }
    </div>
}

<div class="stats-grid">
    <div class="stat-card purple">
        <div class="stat-icon purple">🧪</div>
        <div class="stat-value">@d.TotalRuns</div>
        <div class="stat-label">Tổng lần chạy</div>
    </div>
    <div class="stat-card blue">
        <div class="stat-icon blue">✂️</div>
        <div class="stat-value">@d.ChunkingRuns</div>
        <div class="stat-label">Chunking</div>
    </div>
    <div class="stat-card green">
        <div class="stat-icon green">🧬</div>
        <div class="stat-value">@d.EmbeddingRuns</div>
        <div class="stat-label">Embedding</div>
    </div>
    <div class="stat-card orange">
        <div class="stat-icon orange">🔬</div>
        <div class="stat-value">@d.RagVsFtRuns</div>
        <div class="stat-label">RAG vs FT</div>
    </div>
</div>

<div class="flex gap-2 flex-wrap mb-4">
    <form method="post" asp-page-handler="RunSuite" id="suiteForm">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-primary btn-sm" id="suiteBtn">
            <span id="suiteText">⚡ Chạy bộ thực nghiệm chuẩn (PRN222)</span>
            <span id="suiteSpin" class="hidden animate-spin">⏳ Đang chạy…</span>
        </button>
    </form>
    <a href="/Compare/ChunkingStrategies" class="btn btn-secondary btn-sm">✂️ Chunking</a>
    <a href="/Compare/EmbeddingModels" class="btn btn-secondary btn-sm">🧬 Embedding</a>
    <a href="/Compare/RagVsFineTuned" class="btn btn-secondary btn-sm">🔬 RAG vs Fine-tuned</a>
    <a href="/Compare/Models" class="btn btn-secondary btn-sm">🧪 So sánh Model</a>
</div>

<div class="card mb-6">
    <div class="card-header"><span class="card-title">📈 RAGAS benchmark (@rag.Subject · @rag.Questions câu)</span></div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;padding:0 4px 4px">
        <div><div class="text-sm text-muted">faithfulness</div><div style="font-size:1.4rem;font-weight:700">@rag.Faithfulness.ToString("F3")</div></div>
        <div><div class="text-sm text-muted">answer_relevancy</div><div style="font-size:1.4rem;font-weight:700">@rag.AnswerRelevancy.ToString("F3")</div></div>
        <div><div class="text-sm text-muted">context_precision</div><div style="font-size:1.4rem;font-weight:700">@rag.ContextPrecision.ToString("F3")</div></div>
        <div><div class="text-sm text-muted">context_recall</div><div style="font-size:1.4rem;font-weight:700">@rag.ContextRecall.ToString("F3")</div></div>
    </div>
    <p class="text-sm text-muted" style="margin:12px 0 0">CLI: <code>py -3 eval/ragas_benchmark.py --limit 6</code> · Chi tiết: eval/RAGAS_Results.md</p>
</div>

@if (d.TotalRuns == 0)
{
    <div class="card">
        <div class="empty-state" style="padding:48px">
            <div class="empty-state-icon">📭</div>
            <div class="empty-state-title">Chưa có kết quả thực nghiệm</div>
            <p class="text-muted" style="margin-top:8px">Nhấn <strong>Chạy bộ thực nghiệm chuẩn</strong> hoặc chạy từng benchmark ở menu So sánh.</p>
        </div>
    </div>
}
else
{
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px;margin-bottom:24px">
        <div class="card">
            <div class="card-header"><span class="card-title">✂️ Chunking — avg score</span></div>
            <canvas id="chunkChart" height="200"></canvas>
        </div>
        <div class="card">
            <div class="card-header"><span class="card-title">🧬 Embedding — avg cosine</span></div>
            <canvas id="embedChart" height="200"></canvas>
        </div>
        <div class="card">
            <div class="card-header"><span class="card-title">🔬 RAG vs FT — avg latency (ms)</span></div>
            <canvas id="rftChart" height="200"></canvas>
        </div>
    </div>

    <div class="flex gap-2 flex-wrap mb-4">
        <a href="/Dashboard/Experiments" class="btn btn-sm @(filter == null ? "btn-primary" : "btn-secondary")">Tất cả</a>
        <a href="/Dashboard/Experiments?kind=chunking" class="btn btn-sm @(filter == "chunking" ? "btn-primary" : "btn-secondary")">Chunking</a>
        <a href="/Dashboard/Experiments?kind=embedding" class="btn btn-sm @(filter == "embedding" ? "btn-primary" : "btn-secondary")">Embedding</a>
        <a href="/Dashboard/Experiments?kind=rag-vs-ft" class="btn btn-sm @(filter == "rag-vs-ft" ? "btn-primary" : "btn-secondary")">RAG vs FT</a>
    </div>

    <div class="card" style="padding:0">
        <div class="card-header" style="padding:20px 24px 16px">
            <span class="card-title">📋 Lịch sử lần chạy gần đây @(filter != null ? $"({filter})" : "")</span>
        </div>
        <div class="table-wrapper" style="border:none">
            <table>
                <thead>
                    <tr>
                        <th>Thời gian</th>
                        <th>Loại</th>
                        <th>Câu hỏi</th>
                        <th>Môn</th>
                        <th>Winner</th>
                        <th>Variants</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in d.RecentRuns)
                    {
                        <tr>
                            <td class="text-sm text-muted">@r.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</td>
                            <td>
                                @{
                                    var badge = r.Kind switch
                                    {
                                        "chunking" => "badge-blue",
                                        "embedding" => "badge-green",
                                        _ => "badge-purple"
                                    };
                                }
                                <span class="badge @badge">@r.KindLabel</span>
                            </td>
                            <td style="max-width:280px">
                                <div class="truncate" style="font-weight:600" title="@r.Question">@r.Question</div>
                            </td>
                            <td class="text-sm text-muted">@(r.SubjectName ?? "–")</td>
                            <td>
                                @if (!string.IsNullOrEmpty(r.WinnerLabel))
                                {
                                    <span class="badge badge-green">@r.WinnerLabel</span>
                                }
                                else { <span class="text-muted">–</span> }
                            </td>
                            <td class="text-sm">
                                @foreach (var v in r.Variants.Take(5))
                                {
                                    <div style="margin-bottom:2px">
                                        @if (v.IsError)
                                        {
                                            <span class="text-muted">@v.VariantLabel · lỗi</span>
                                        }
                                        else
                                        {
                                            <strong>@v.VariantLabel</strong>
                                            <span class="text-muted"> · @v.Score.ToString("F2") · @v.LatencyMs ms</span>
                                        }
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
    const suiteForm = document.getElementById('suiteForm');
    if (suiteForm) {
        suiteForm.addEventListener('submit', function () {
            document.getElementById('suiteText').classList.add('hidden');
            document.getElementById('suiteSpin').classList.remove('hidden');
            document.getElementById('suiteBtn').disabled = true;
        });
    }

    const chunkLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(d.ChunkingAgg.Select(x => x.VariantLabel)));
    const chunkScores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(d.ChunkingAgg.Select(x => Math.Round(x.AvgScore, 3))));
    const embedLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(d.EmbeddingAgg.Select(x => x.VariantLabel)));
    const embedScores = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(d.EmbeddingAgg.Select(x => Math.Round(x.AvgScore, 3))));
    const rftLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(d.RagVsFtAgg.Select(x => x.VariantLabel)));
    const rftLatency = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(d.RagVsFtAgg.Select(x => Math.Round(x.AvgLatencyMs, 0))));

    function barChart(id, labels, data, color) {
        const el = document.getElementById(id);
        if (!el || !window.Chart || !labels.length) return;
        new Chart(el, {
            type: 'bar',
            data: {
                labels,
                datasets: [{ label: 'Giá trị', data, backgroundColor: color, borderRadius: 6, maxBarThickness: 48 }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: {
                    x: { ticks: { color: '#a99d8e', maxRotation: 30 }, grid: { display: false } },
                    y: { beginAtZero: true, ticks: { color: '#a99d8e' }, grid: { color: 'rgba(43,37,33,0.06)' } }
                }
            }
        });
    }

    barChart('chunkChart', chunkLabels, chunkScores, 'rgba(99,102,241,0.75)');
    barChart('embedChart', embedLabels, embedScores, 'rgba(6,182,212,0.75)');
    barChart('rftChart', rftLabels, rftLatency, 'rgba(245,158,11,0.75)');
</script>
}
