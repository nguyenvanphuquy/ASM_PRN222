@page
@model PresentationLayer.Pages.Reports.IndexModel
@{
    ViewData["Title"] = "Báo cáo & Thống kê";
    var t = Model.Tokens;
    var r = Model.Revenue;
    string RangeLabel(string x) => x == "week" ? "7 ngày" : x == "all" ? "Tất cả" : "30 ngày";
}

<div class="page-header flex items-center justify-between" style="flex-wrap:wrap;gap:12px">
    <div>
        <h1>Báo cáo &amp; Thống kê</h1>
        <p>Tiêu thụ token theo người dùng &amp; doanh thu gói · <span class="text-sm" style="color:var(--accent-green)">● cập nhật trực tiếp</span></p>
    </div>
    <div class="flex gap-2">
        <a href="?range=week"  class="btn btn-sm @(Model.Range == "week" ? "btn-primary" : "btn-secondary")">Tuần</a>
        <a href="?range=month" class="btn btn-sm @(Model.Range == "month" ? "btn-primary" : "btn-secondary")">Tháng</a>
        <a href="?range=all"   class="btn btn-sm @(Model.Range == "all" ? "btn-primary" : "btn-secondary")">Tất cả</a>
    </div>
</div>

<!-- ══════════ PHẦN 1: TIÊU THỤ TOKEN ══════════ -->
<h3 style="margin:8px 0 14px">🔢 Tiêu thụ token — @RangeLabel(Model.Range)</h3>
<div class="stats-grid">
    <div class="stat-card purple">
        <div class="stat-icon purple">🔢</div>
        <div class="stat-value">@t.TotalTokens.ToString("N0")</div>
        <div class="stat-label">Tổng token đã dùng</div>
    </div>
    <div class="stat-card blue">
        <div class="stat-icon blue">💬</div>
        <div class="stat-value">@t.TotalRequests.ToString("N0")</div>
        <div class="stat-label">Lượt gọi AI</div>
    </div>
    <div class="stat-card green">
        <div class="stat-icon green">👤</div>
        <div class="stat-value">@t.ActiveUsers</div>
        <div class="stat-label">Người dùng hoạt động</div>
    </div>
    <div class="stat-card orange">
        <div class="stat-icon orange">💵</div>
        <div class="stat-value">@t.TotalCostVnd.ToString("N0")₫</div>
        <div class="stat-label">Chi phí token ước tính</div>
    </div>
</div>

<div style="display:grid;grid-template-columns:1.4fr 1fr;gap:20px;margin-bottom:24px">
    <div class="card">
        <div class="card-header"><span class="card-title">📈 Token theo ngày</span></div>
        <canvas id="dailyChart" height="120"></canvas>
    </div>
    <div class="card">
        <div class="card-header"><span class="card-title">🤖 Theo model</span></div>
        @if (t.ByModel.Count == 0)
        {
            <div class="empty-state" style="padding:24px"><div class="empty-state-icon">🤖</div><div class="empty-state-title">Chưa có dữ liệu</div></div>
        }
        else
        {
            foreach (var m in t.ByModel)
            {
                var pct = t.TotalTokens > 0 ? (int)(m.Tokens * 100 / t.TotalTokens) : 0;
                <div style="margin-bottom:14px">
                    <div class="flex items-center justify-between" style="margin-bottom:6px">
                        <span class="text-sm" style="font-weight:600">@m.DisplayName</span>
                        <span class="text-sm text-muted">@m.Tokens.ToString("N0") · @m.Requests lượt</span>
                    </div>
                    <div style="height:8px;background:var(--bg-secondary);border-radius:var(--radius-full);overflow:hidden">
                        <div style="height:100%;width:@(pct)%;background:var(--grad-primary);border-radius:var(--radius-full)"></div>
                    </div>
                </div>
            }
        }
    </div>
</div>

<!-- Ai đang dùng bao nhiêu token -->
<div class="card mb-6" style="padding:0">
    <div class="card-header" style="padding:20px 24px 16px"><span class="card-title">🏆 Ai đang dùng bao nhiêu token</span></div>
    <div class="table-wrapper" style="border:none">
        <table>
            <thead>
                <tr><th>#</th><th>Người dùng</th><th>Vai trò</th><th class="text-right">Lượt gọi</th><th class="text-right">Token</th><th class="text-right">Chi phí ước tính</th></tr>
            </thead>
            <tbody>
                @if (t.ByUser.Count == 0)
                {
                    <tr><td colspan="6" style="text-align:center;padding:28px;color:var(--text-muted)">Chưa có ai dùng token trong khoảng thời gian này.</td></tr>
                }
                else
                {
                    var rank = 0;
                    foreach (var u in t.ByUser)
                    {
                        rank++;
                        var roleClass = u.Role == "Admin" ? "badge-red" : u.Role == "Lecturer" ? "badge-blue" : "badge-green";
                        <tr>
                            <td style="font-weight:700;color:var(--text-muted)">@rank</td>
                            <td style="font-weight:600;color:var(--text-primary)">@u.UserName</td>
                            <td><span class="badge @roleClass">@u.Role</span></td>
                            <td class="text-right">@u.Requests.ToString("N0")</td>
                            <td class="text-right" style="font-weight:700;color:var(--accent-purple)">@u.Tokens.ToString("N0")</td>
                            <td class="text-right text-muted">@u.CostVnd.ToString("N0")₫</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ══════════ PHẦN 2: DOANH THU GÓI ══════════ -->
<h3 style="margin:8px 0 14px">💳 Doanh thu &amp; lợi nhuận gói</h3>
<div class="stats-grid">
    <div class="stat-card green">
        <div class="stat-icon green">💰</div>
        <div class="stat-value" id="revTotal">@r.TotalRevenueVnd.ToString("N0")₫</div>
        <div class="stat-label">Tổng doanh thu</div>
    </div>
    <div class="stat-card purple">
        <div class="stat-icon purple">🧾</div>
        <div class="stat-value" id="revCount">@r.TotalPurchases</div>
        <div class="stat-label">Lượt mua gói</div>
    </div>
    <div class="stat-card blue">
        <div class="stat-icon blue">🙋</div>
        <div class="stat-value">@r.PayingUsers</div>
        <div class="stat-label">Người dùng trả phí</div>
    </div>
    <div class="stat-card orange">
        <div class="stat-icon orange">📊</div>
        <div class="stat-value" style="color:@(r.ProfitVnd >= 0 ? "var(--accent-green)" : "var(--accent-red)")">@r.ProfitVnd.ToString("N0")₫</div>
        <div class="stat-label">Lợi nhuận ước tính</div>
    </div>
</div>

<div style="display:grid;grid-template-columns:1fr 1fr;gap:20px">
    <!-- Doanh thu theo gói -->
    <div class="card" style="padding:0">
        <div class="card-header" style="padding:20px 24px 16px"><span class="card-title">📦 Doanh thu theo gói</span></div>
        <div class="table-wrapper" style="border:none">
            <table>
                <thead>
                    <tr><th>Gói</th><th class="text-right">Lượt</th><th class="text-right">Doanh thu</th><th class="text-right">Token bán / dùng</th></tr>
                </thead>
                <tbody>
                    @if (r.ByPackage.Count == 0)
                    {
                        <tr><td colspan="4" style="text-align:center;padding:24px;color:var(--text-muted)">Chưa có giao dịch mua gói.</td></tr>
                    }
                    else
                    {
                        foreach (var p in r.ByPackage)
                        {
                            <tr>
                                <td style="font-weight:600;color:var(--text-primary)">@p.PackageName</td>
                                <td class="text-right">@p.Count</td>
                                <td class="text-right" style="font-weight:700;color:var(--accent-green)">@p.RevenueVnd.ToString("N0")₫</td>
                                <td class="text-right text-muted">@p.TokensSold.ToString("N0") / @p.TokensUsed.ToString("N0")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div style="padding:14px 24px;border-top:1px solid var(--border-subtle);display:flex;justify-content:space-between;font-size:0.82rem;color:var(--text-secondary)">
            <span>Token đã bán: <strong>@r.TokensSold.ToString("N0")</strong></span>
            <span>Chi phí LLM ước tính: <strong>@r.EstimatedCostVnd.ToString("N0")₫</strong></span>
        </div>
    </div>

    <!-- Giao dịch gần đây -->
    <div class="card" style="padding:0">
        <div class="card-header" style="padding:20px 24px 16px"><span class="card-title">🕒 Giao dịch gần đây</span></div>
        <div class="table-wrapper" style="border:none">
            <table>
                <thead>
                    <tr><th>Người dùng</th><th>Gói</th><th class="text-right">Số tiền</th><th class="text-right">Thời gian</th></tr>
                </thead>
                <tbody id="recentPurchases">
                    @if (r.Recent.Count == 0)
                    {
                        <tr><td colspan="4" style="text-align:center;padding:24px;color:var(--text-muted)">Chưa có giao dịch.</td></tr>
                    }
                    else
                    {
                        foreach (var p in r.Recent)
                        {
                            <tr>
                                <td style="font-weight:600;color:var(--text-primary)">@p.UserName</td>
                                <td class="text-sm">@p.PackageName</td>
                                <td class="text-right" style="font-weight:600">@p.AmountVnd.ToString("N0")₫</td>
                                <td class="text-right text-sm text-muted">@p.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script>
    function escHtml(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
    const dailyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Tokens.Daily.Select(d => d.Date.ToString("dd/MM"))));
    const dailyData   = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Tokens.Daily.Select(d => d.Tokens)));

    const ctx = document.getElementById('dailyChart');
    if (ctx && window.Chart) {
        const css = getComputedStyle(document.documentElement);
        const brand = (css.getPropertyValue('--accent-purple') || '#e0763a').trim();
        const grad = ctx.getContext('2d').createLinearGradient(0, 0, 0, 200);
        grad.addColorStop(0, 'rgba(224,118,58,0.35)');
        grad.addColorStop(1, 'rgba(224,118,58,0.02)');
        new Chart(ctx, {
            type: 'line',
            data: { labels: dailyLabels, datasets: [{
                label: 'Token', data: dailyData, borderColor: brand, backgroundColor: grad,
                fill: true, tension: 0.35, pointRadius: 3, pointBackgroundColor: brand, borderWidth: 2
            }]},
            options: {
                plugins: { legend: { display: false } },
                scales: {
                    x: { grid: { display: false }, ticks: { color: '#a99d8e' } },
                    y: { beginAtZero: true, grid: { color: 'rgba(43,37,33,0.06)' }, ticks: { color: '#a99d8e' } }
                }
            }
        });
    }

    // ── Realtime: doanh thu tăng ngay khi có người mua gói ──
    (function () {
        let count = @r.TotalPurchases, revenue = @r.TotalRevenueVnd;
        function onPurchase(d) {
            if (!d) return;
            count += 1; revenue += Number(d.amountVnd || 0);
            const c = document.getElementById('revCount'); if (c) c.textContent = count;
            const rv = document.getElementById('revTotal'); if (rv) rv.textContent = revenue.toLocaleString('vi-VN') + '₫';
            const tbody = document.getElementById('recentPurchases');
            if (tbody) {
                if (tbody.querySelector('td[colspan]')) tbody.innerHTML = ''; // bỏ dòng "chưa có giao dịch"
                const tr = document.createElement('tr');
                tr.innerHTML = `<td style="font-weight:600;color:var(--text-primary)">Vừa mua</td><td class="text-sm">${escHtml(d.packageName)}</td><td class="text-right" style="font-weight:600">${Number(d.amountVnd).toLocaleString('vi-VN')}₫</td><td class="text-right text-sm text-muted">${escHtml(d.time || '')}</td>`;
                tr.style.background = 'rgba(63,164,106,0.12)';
                tbody.insertBefore(tr, tbody.firstElementChild);
            }
        }
        (function sub() { if (window.appNotifHub) window.appNotifHub.on('PackagePurchased', onPurchase); else setTimeout(sub, 300); })();
    })();
</script>
}
